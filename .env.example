# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# --- EmailJS (form Kontak) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Notion ---
NOTION_TOKEN=
# Database blog
NOTION_DATABASE_ID=
NOTION_PROJECTS_ID=
NOTION_TESTIMONIALS_ID=
# Database "Books" dan "Pembaca" (halaman /books) — lihat docs/books-setup.md
NOTION_BOOKS_ID=
NOTION_READERS_ID=

# --- Halaman Buku: pengiriman ebook lewat email (Resend) ---
RESEND_API_KEY=
BOOKS_EMAIL_FROM="Faqih Nur Fahmi <buku@faqih.id>"

# --- Halaman Buku: Cloudflare Turnstile (anti-bot di form unduh) ---
# Untuk pengembangan lokal bisa memakai kunci uji Cloudflare yang selalu lolos:
#   site key   1x00000000000000000000AA
#   secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Lain-lain ---
GITHUB_TOKEN=

# --- Gambar Notion → Cloudflare R2 (opsional) ---
# Kalau semua diisi, gambar unggahan Notion disalin otomatis ke R2 dan ditampilkan dari CDN.
# Kalau kosong, situs tetap memakai URL gambar Notion seperti biasa.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.faqih.id
